# =====================================================================
# Taadeen Automation — local configuration template
# ---------------------------------------------------------------------
# 1. Copy this file to `.env` (same folder).  `.env` is git-ignored.
# 2. Fill in the values for the environments you use.
# 3. Run `npm run env:check` to validate.
#
# Naming convention (the framework builds these keys automatically):
#   <ENV>_<PORTAL>_URL          -> login URL of a portal in an environment
#   <ENV>_<USERKEY>_USERNAME    -> username of a user in an environment
#   <ENV>_<USERKEY>_PASSWORD    -> password of a user in an environment
#
#   ENV     = DEV | SIT | TEST | UAT | PROD
#   PORTAL  = INVESTOR | EMPLOYEE              (see src/config/portals.ts)
#   USERKEY = INVESTOR1 | EMPLOYEE1 | ...      (see src/config/users.ts)
#
# In CI, set the same names as pipeline secrets/variables instead of a file.
# Real environment variables always win over values in this file.
# =====================================================================

# Default environment when TEST_ENV is not set by an npm script
TEST_ENV=uat

# ---------------------------------------------------------------------
# DEV
# ---------------------------------------------------------------------
DEV_INVESTOR_URL=
DEV_EMPLOYEE_URL=
DEV_INVESTOR1_USERNAME=
DEV_INVESTOR1_PASSWORD=
DEV_EMPLOYEE1_USERNAME=
DEV_EMPLOYEE1_PASSWORD=

# ---------------------------------------------------------------------
# SIT
# ---------------------------------------------------------------------
SIT_INVESTOR_URL=
SIT_EMPLOYEE_URL=
SIT_INVESTOR1_USERNAME=
SIT_INVESTOR1_PASSWORD=
SIT_EMPLOYEE1_USERNAME=
SIT_EMPLOYEE1_PASSWORD=

# ---------------------------------------------------------------------
# TEST
# ---------------------------------------------------------------------
TEST_INVESTOR_URL=https://platform-test.taadeen.dev/MiningPortal/Login
TEST_EMPLOYEE_URL=https://platform-test.taadeen.dev/MiningPortal/Login_LDAP
TEST_INVESTOR1_USERNAME=company9owner@uat.co
TEST_INVESTOR1_PASSWORD=
TEST_EMPLOYEE1_USERNAME=
TEST_EMPLOYEE1_PASSWORD=

# ---------------------------------------------------------------------
# UAT
# ---------------------------------------------------------------------
UAT_INVESTOR_URL=https://platform-uat.taadeen.dev/MiningPortal/Login
UAT_EMPLOYEE_URL=https://platform-uat.taadeen.dev/MiningPortal/Login_LDAP
UAT_INVESTOR1_USERNAME=mghandour
UAT_INVESTOR1_PASSWORD=
UAT_EMPLOYEE1_USERNAME=MIM_SuperUser
UAT_EMPLOYEE1_PASSWORD=

# ---------------------------------------------------------------------
# PROD (optional — restricted, see README "Production safety")
# ---------------------------------------------------------------------
PROD_INVESTOR_URL=
PROD_EMPLOYEE_URL=
PROD_INVESTOR1_USERNAME=
PROD_INVESTOR1_PASSWORD=
PROD_EMPLOYEE1_USERNAME=
PROD_EMPLOYEE1_PASSWORD=
# Must be explicitly set to true to run anything against PROD
ALLOW_PROD_RUN=false

# ---------------------------------------------------------------------
# Optional tuning (apply to every environment)
# ---------------------------------------------------------------------
# Reuse saved login sessions between runs (minutes). 0 = always log in fresh.
AUTH_SESSION_TTL_MINUTES=30
# Run browsers headless (true/false)
HEADLESS=true
# Parallel workers (number or percentage, e.g. 4 or 50%)
WORKERS=

# ---------------------------------------------------------------------
# Payment notification utility (<host>/TadeenTest/CallPaymentNotification)
# ---------------------------------------------------------------------
# Environments allowed to mark bills as paid through the utility (comma-separated; prod is always refused)
PAYMENT_UTILITY_ENVS=test,uat
# serviceProviderID per environment. Empty = send the template's own value (works on TEST and UAT).
# Do NOT use the page's 'UAT: 004' note: UAT refuses 004 (400 Bad Request); its template value 002 works.
TEST_PAYMENT_SERVICE_PROVIDER_ID=
UAT_PAYMENT_SERVICE_PROVIDER_ID=

# ---------------------------------------------------------------------
# Per-run options (usually set on the command line instead)
# ---------------------------------------------------------------------
# Existing request opened by tests/exploration-license (digits only)
REQUEST_NUMBER=
# true = press the final "إرسال" (Submit). Anything else stops before submission.
ALLOW_SUBMIT=false
