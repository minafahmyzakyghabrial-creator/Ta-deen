{
  "name": "taadeen-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test automation framework for the Taadeen (OutSystems) platform",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:sit": "cross-env TEST_ENV=sit playwright test",
    "test:test": "cross-env TEST_ENV=test playwright test",
    "test:uat": "cross-env TEST_ENV=uat playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:uat:smoke": "cross-env TEST_ENV=uat playwright test --grep @smoke",
    "test:uat:e2e": "cross-env TEST_ENV=uat playwright test --grep @e2e",
    "test:sit:smoke": "cross-env TEST_ENV=sit playwright test --grep @smoke",
    "test:test:smoke": "cross-env TEST_ENV=test playwright test --grep @smoke",
    "test:exploration": "cross-env TEST_ENV=test playwright test tests/exploration-license/exploration-license-issuance.spec.ts --project=chromium --headed",
    "test:new-exploration": "cross-env TEST_ENV=test playwright test tests/exploration-license/new-exploration-license.spec.ts --project=chromium --headed",
    "test:new-exploration:fast": "cross-env TEST_ENV=test RECORD=off playwright test tests/exploration-license/new-exploration-license.spec.ts --project=chromium",
    "test:dev:smoke": "cross-env TEST_ENV=dev playwright test --grep @smoke",
    "test:headed": "cross-env TEST_ENV=uat playwright test --headed --workers=1",
    "test:debug": "cross-env TEST_ENV=uat PWDEBUG=1 playwright test --workers=1",
    "test:ui": "cross-env TEST_ENV=uat playwright test --ui",
    "test:list": "playwright test --list",
    "env:check": "tsx scripts/check-env.ts",
    "auth:clear": "tsx scripts/clear-auth.ts",
    "record": "tsx scripts/record.ts",
    "kml": "tsx scripts/generate-kml.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report reports/html",
    "allure:generate": "allure generate allure-results --clean -o reports/allure",
    "allure:open": "allure open reports/allure",
    "allure:serve": "allure serve allure-results"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.4.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
