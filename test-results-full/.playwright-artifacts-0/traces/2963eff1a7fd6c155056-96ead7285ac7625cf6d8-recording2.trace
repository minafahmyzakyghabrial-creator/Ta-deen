{"type":"frame-snapshot","snapshot":{"callId":"konu@111","phase":"after","pageId":"page@6e23e650d270ab6f4c365f28d367efe1","frameId":"frame@e96f6c012b11e839cf14768494195c3d","frameUrl":"https://platform-test.taadeen.dev/MiningInternal/HomePage","doctype":"html","html":["HTML",{"lang":"ar-SA"},["HEAD",{},["BASE",{"href":"https://platform-test.taadeen.dev/MiningInternal/HomePage"}],"\n        ",["META",{"http-equiv":"X-UA-Compatible","content":"IE=edge"}],"\n        ",["META",{"http-equiv":"Content-Type","content":"text/html; charset=utf-8"}],"\n        ",["META",{"name":"format-detection","content":"telephone=no"}],"\n        ","\n        \n        \n        ",["META",{"name":"viewport","content":"viewport-fit=cover, width=device-width, initial-scale=1"}],"\n","\n\n        ","\n","\n","\n","\n","\n","\n","\n",["LINK",{"type":"text/css","rel":"stylesheet","href":"css/_Basic.css?EqGzAe81QbZLXJyfY3oLwA"}],"\n\n        ","\n    ",["STYLE",{},".digital-stamp-card { padding: 8px 32px; background: rgb(243, 244, 246); }\n.digital-stamp-card .digital-stamp-header { display: flex; align-items: center; gap: 10px; }\n.digital-stamp-card .digital-stamp-header h6 { margin: 0px; color: rgb(22, 22, 22); font-size: 14px; }\n.digital-stamp-card .digital-stamp-header .btn-digital-stamp-card { cursor: pointer; }\n.digital-stamp-card .digital-stamp-header .btn-digital-stamp-card span { color: rgb(27, 131, 84); font-size: 14px; }\n.digital-stamp-card .digital-stamp-header .btn-digital-stamp-card svg, .digital-stamp-card .digital-stamp-header .btn-digital-stamp-card img { transition: 0.3s; }\n.digital-stamp-card .digital-stamp-header.open .btn-digital-stamp-card svg, .digital-stamp-card .digital-stamp-header.open .btn-digital-stamp-card img { transform: rotate(180deg); }\n.btn-digital-stamp-card img { margin-right: 4px; margin-left: 4px; }\n.digital-stamp-card .digital-stamp-body { padding-top: 40px; padding-bottom: 32px; display: none; }\n.digital-stamp-card .digital-stamp-body .digital-stamp-container { margin-bottom: 32px; display: flex; gap: 32px; }\n.digital-stamp-card .digital-stamp-body .digital-stamp-container .box { display: flex; align-items: flex-start; gap: 18px; }\n.digital-stamp-card .digital-stamp-body .digital-stamp-container .box .img-border-rounded { padding: 14px 16px; display: flex; align-items: center; justify-content: center; border: 1px solid rgb(6, 118, 71); border-radius: 100%; }\n.digital-stamp-card .digital-stamp-body .digital-stamp-container .box h6 { margin-top: 0px; margin-bottom: 12px; color: rgb(22, 22, 22); font-size: 18px; }\n.digital-stamp-card .digital-stamp-body .digital-stamp-container .box .green-text { color: rgb(27, 131, 84); }\n.digital-stamp-card .digital-stamp-body .digital-stamp-container .box p { margin: 0px; color: rgb(56, 66, 80); font-size: 16px; }\n.digital-stamp-card .digital-stamp-body .stamp-link-box { padding: 8px 28px; display: flex; align-items: center; gap: 12px; border-radius: 8px; background: rgb(255, 255, 255); }\n.digital-stamp-card .digital-stamp-body .stamp-link-box p { margin: 0px; color: rgb(22, 22, 22); font-size: 16px; }\n.digital-stamp-card .digital-stamp-body .stamp-link-box a { color: rgb(27, 131, 84); font-size: 16px; text-decoration: underline; }\n.stamp-ar { direction: rtl; }\n.stamp-en { direction: ltr; }\n@media (max-width: 768px) {\n  .digital-stamp-card { padding: 8px 16px; }\n  .digital-stamp-card .digital-stamp-header { flex-wrap: wrap; }\n  .digital-stamp-card .digital-stamp-header .btn-digital-stamp-card { flex: 1 1 100%; margin-right: 33px; }\n  .digital-stamp-card .digital-stamp-body .digital-stamp-container { flex-direction: column; }\n  [dir=\"ltr\"] .digital-stamp-card .digital-stamp-header .btn-digital-stamp-card { margin-right: 0px; margin-left: 33px; }\n}\n.digital-stamp-card .btn-digital-stamp-card .chev { transform: rotate(0deg); transition: transform 0.25s; transform-origin: 50% 50%; }\n.digital-stamp-card .digital-stamp-header.open btn-digital-stamp-card .chev { transform: rotate(180deg); }\n.mim-header-reg { height: inherit !important; }"],["LINK",{"type":"text/css","rel":"stylesheet","id":"/MiningInternal/css/OutSystemsReactWidgets.css?kQjDkbMH8s8gQl+B0cPCxA","href":"/MiningInternal/css/OutSystemsReactWidgets.css?kQjDkbMH8s8gQl+B0cPCxA","data-os":"true"}],["LINK",{"type":"text/css","rel":"stylesheet","id":"/MiningInternal/css/Mining_Common_CW.SupportedLayout.Notification_Dropdown.css?JzxR_LpmL4fhzSzq00t5og","href":"/MiningInternal/css/Mining_Common_CW.SupportedLayout.Notification_Dropdown.css?JzxR_LpmL4fhzSzq00t5og","data-os":"true"}],["LINK",{"type":"text/css","rel":"stylesheet","id":"/MiningInternal/css/Mining_Common_CW.Menu.SideMenu_new.css?3QHG_Izzf8Inirtytx9s9Q","href":"/MiningInternal/css/Mining_Common_CW.Menu.SideMenu_new.css?3QHG_Izzf8Inirtytx9s9Q","data-os":"true"}],["LINK",{"type":"text/css","rel":"stylesheet","id":"/MiningInternal/css/SharedService_Dashboard_CW.MainFlow.InternalDashboard.css?12zKw27b8RhLPMFbINKGeg","href":"/MiningInternal/css/SharedService_Dashboard_CW.MainFlow.InternalDashboard.css?12zKw27b8RhLPMFbINKGeg","data-os":"true"}],["LINK",{"type":"text/css","rel":"stylesheet","id":"/MiningInternal/css/OutSystemsUI.OutSystemsUI.css?vMB56QJxIlJtGb8k8Q0K5A","href":"/MiningInternal/css/OutSystemsUI.OutSystemsUI.css?vMB56QJxIlJtGb8k8Q0K5A","data-os":"true"}],["LINK",{"type":"text/css","rel":"stylesheet","id":"/MiningInternal/css/Theme.Theme.css?bgPJKrDAW5UbQpUG7GTe5A","href":"/MiningInternal/css/Theme.Theme.css?bgPJKrDAW5UbQpUG7GTe5A","data-os":"true"}],["LINK",{"type":"text/css","rel":"stylesheet","id":"/MiningInternal/css/Theme.dga_dev1.css?QrdDvaK9GEECy4Soorzr2A","href":"/MiningInternal/css/Theme.dga_dev1.css?QrdDvaK9GEECy4Soorzr2A","data-os":"true"}],["LINK",{"type":"text/css","rel":"stylesheet","id":"/MiningInternal/css/Theme.dga_dev2.css?zmcAJK4u7+anODdGd4AAug","href":"/MiningInternal/css/Theme.dga_dev2.css?zmcAJK4u7+anODdGd4AAug","data-os":"true"}],["LINK",{"type":"text/css","rel":"stylesheet","